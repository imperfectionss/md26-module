# MD-26 : vos fournisseurs de modeles. Copiez ce fichier en .env, puis
# remplacez chaque ... par votre cle. Le .env ne part jamais sur GitHub.
#
# Les noms et les prix du jour sont dans l'annexe C du polycopie, section 7.
# Les prix sont les tarifs payants, en dollars par million de tokens, meme
# sur une offre gratuite : sans eux, le cout ne se mesure pas.

FOURNISSEUR_PRINCIPAL=groq
FOURNISSEUR_SECOURS=nvidia
FOURNISSEUR_MESURE=zai
FOURNISSEUR_GRAND_MODELE=gemini-lite
# Recours du grand modele, plus capable mais au quota plus serre :
# FOURNISSEUR_GRAND_MODELE=gemini ; ou, plus lent, FOURNISSEUR_GRAND_MODELE=glm.

# Principal : le developpement, tous les jours
LLM_GROQ_URL=https://api.groq.com/openai/v1/chat/completions
LLM_GROQ_CLE=...
LLM_GROQ_MODELE=openai/gpt-oss-20b
LLM_GROQ_MAX_TOKENS=2048
LLM_GROQ_PRIX_ENTREE=0.075
LLM_GROQ_PRIX_SORTIE=0.30

# Secours : le meme modele, quand le principal atteint son plafond du jour.
# Sans cle NVIDIA au bout de 48 heures, prenez Cloudflare (annexe C, section 7).
LLM_NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_NVIDIA_CLE=...
LLM_NVIDIA_MODELE=openai/gpt-oss-20b
LLM_NVIDIA_PRIX_ENTREE=0.075
LLM_NVIDIA_PRIX_SORTIE=0.30

# Mesure : le banc de mesure.py, sans quota journalier, une requete a la fois.
# C'est aussi le modele de l'experience du TP2 : 200 000 tokens de fenetre. Un
# long contexte peut y prendre plus d'une minute quand le service est charge :
# DELAI laisse cinq minutes a la reponse, au lieu de deux par defaut.
LLM_ZAI_URL=https://api.z.ai/api/paas/v4/chat/completions
LLM_ZAI_CLE=...
LLM_ZAI_MODELE=glm-4.7-flash
LLM_ZAI_OPTIONS={"thinking": {"type": "disabled"}}
LLM_ZAI_DELAI=300
LLM_ZAI_PRIX_ENTREE=0.07
LLM_ZAI_PRIX_CACHE=0.01
LLM_ZAI_PRIX_SORTIE=0.40

# Grand modele : la cascade du TP11 y envoie ses escalades, il doit donc etre
# plus capable que le modele des mesures. Gemini 3.5 Flash-Lite, chez Google AI
# Studio, avec la cle de votre moteur A du TP1 bis : le 17 octobre 2026, il
# repondait en moins de deux secondes et appelait les outils. Prix publies par
# Google (page des tarifs, 16 octobre 2026). Son quota du jour s'affiche dans
# AI Studio : relevez-le avant le TP11.
LLM_GEMINI_LITE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_GEMINI_LITE_CLE=...
LLM_GEMINI_LITE_MODELE=gemini-3.5-flash-lite
LLM_GEMINI_LITE_PRIX_ENTREE=0.30
LLM_GEMINI_LITE_PRIX_CACHE=0.03
LLM_GEMINI_LITE_PRIX_SORTIE=2.50

# Recours lent du grand modele : glm-5.3-flash, servi par NVIDIA, de preference
# sur un second compte. Les 16 et 17 octobre 2026, sur l'offre d'essai, il a mis
# de 75 secondes a plus de cinq minutes par appel, raisonnement bas compris.
# Prix publies par Z.ai (liste, 26 aout 2026). DELAI : on attend sa reponse
# jusqu'a cinq minutes, au lieu de deux par defaut.
LLM_GLM_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_GLM_CLE=...
LLM_GLM_MODELE=z-ai/glm-5.3-flash
LLM_GLM_OPTIONS={"reasoning_effort": "low"}
LLM_GLM_DELAI=300
LLM_GLM_PRIX_ENTREE=0.15
LLM_GLM_PRIX_CACHE=0.03
LLM_GLM_PRIX_SORTIE=0.50

# Recours du grand modele : Gemini 3.8 Flash, la meme cle Google, plus capable
# que Flash-Lite mais au quota du jour plus serre. Le moteur A du TP1 bis, un
# modele proprietaire, se declare a part, en LLM_A_ (feuille du TP1 bis).
LLM_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_GEMINI_CLE=...
LLM_GEMINI_MODELE=gemini-3.8-flash
LLM_GEMINI_PRIX_ENTREE=0.75
LLM_GEMINI_PRIX_SORTIE=3.75

# Recours sans telephone, si la cle NVIDIA ne vient pas ou si Z.ai tombe :
# Cloudflare Workers AI sert les memes modeles (annexe C, section 7). Une cle
# pour les deux blocs ; l'adresse porte l'identifiant de votre compte, a mettre
# a la place de <ID_DU_COMPTE>. Pour vous en servir, nommez cloudflare dans
# FOURNISSEUR_SECOURS, ou cloudflare-glm dans FOURNISSEUR_MESURE. Chez
# Cloudflare, glm-4.7-flash tient 131 072 tokens : assez pour les cases du TP2.
LLM_CLOUDFLARE_URL=https://api.cloudflare.com/client/v4/accounts/<ID_DU_COMPTE>/ai/v1/chat/completions
LLM_CLOUDFLARE_CLE=...
LLM_CLOUDFLARE_MODELE=@cf/openai/gpt-oss-20b
LLM_CLOUDFLARE_PRIX_ENTREE=0.20
LLM_CLOUDFLARE_PRIX_SORTIE=0.30

LLM_CLOUDFLARE_GLM_URL=https://api.cloudflare.com/client/v4/accounts/<ID_DU_COMPTE>/ai/v1/chat/completions
LLM_CLOUDFLARE_GLM_CLE=...
LLM_CLOUDFLARE_GLM_MODELE=@cf/zai-org/glm-4.7-flash
LLM_CLOUDFLARE_GLM_PRIX_ENTREE=0.06
LLM_CLOUDFLARE_GLM_PRIX_SORTIE=0.40

# Le modele local, au bloc 1.5. Ollama n'exige pas de cle : laissez ollama.
LLM_LOCAL_URL=http://localhost:11434/v1/chat/completions
LLM_LOCAL_CLE=ollama
LLM_LOCAL_MODELE=qwen3.5:4b
LLM_LOCAL_PRIX_ENTREE=0
LLM_LOCAL_PRIX_SORTIE=0
